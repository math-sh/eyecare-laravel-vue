APP_NAME=EyeCare
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=eyecare
DB_USERNAME=root
DB_PASSWORD=root

# API stateless: sem sessao, sem fila, cache em arquivo.
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Origens liberadas no CORS (o painel Vue).
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173
