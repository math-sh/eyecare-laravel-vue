{
  "name": "eyecare-painel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "lint": "eslint . --ext .vue,.ts,.js --max-warnings 0",
    "format": "prettier --write src",
    "prepare": "cd .. && husky painel/.husky"
  },
  "lint-staged": {
    "*.{vue,ts,js}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "axios": "1.7.9",
    "vue": "2.7.16",
    "vue-router": "3.6.5",
    "vuetify": "2.7.2"
  },
  "devDependencies": {
    "@mdi/font": "7.4.47",
    "@typescript-eslint/eslint-plugin": "8.18.0",
    "@typescript-eslint/parser": "8.18.0",
    "@vitejs/plugin-vue2": "2.3.3",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-vue": "9.32.0",
    "husky": "9.1.7",
    "lint-staged": "15.2.10",
    "prettier": "3.4.2",
    "typescript": "5.7.2",
    "vite": "5.4.11"
  }
}
